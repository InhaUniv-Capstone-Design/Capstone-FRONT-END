<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Yakyeon" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Yakyeon" parent="Base.Theme.Yakyeon" />

    <style name="Theme.Yakyeon.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Yakyeon.BottomSheet</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Widget.Yakyeon.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="Theme.Yakyeon.ConsentDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="colorPrimary">@color/brand</item>
    </style>

    <style name="Widget.Yakyeon.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/login_button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="cornerRadius">999dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Yakyeon.Button.Primary.Compact">
        <item name="android:layout_height">@dimen/action_button_height</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Yakyeon.Button.Secondary" parent="Widget.Yakyeon.Button.Primary">
        <item name="android:textColor">@color/brand_dark</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/brand</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Yakyeon.Button.Ghost" parent="Widget.Yakyeon.Button.Primary.Compact">
        <item name="android:layout_width">104dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Yakyeon.Text.Label" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

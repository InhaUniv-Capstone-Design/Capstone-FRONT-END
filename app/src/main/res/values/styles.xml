<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 색과 크기는 Material3 테마 속성을 따른다. Figma 측정값이 아니다. -->
    <style name="TextAppearance.Yakyeon.Header" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Widget.Yakyeon.ConsentLabel" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/yakyeon_brand</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Yakyeon.ConsentValue" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/yakyeon_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Yakyeon.FieldLabel" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/yakyeon_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Yakyeon.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">26dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Yakyeon.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">26dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/yakyeon_primary</item>
        <item name="android:textColor">@color/yakyeon_brand</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Yakyeon.Button.Compact" parent="Widget.Yakyeon.Button.Secondary">
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="minTouchTargetSize">0dp</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Yakyeon.Button.Envelope" parent="Widget.Yakyeon.Button.Secondary">
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/yakyeon_chip_line</item>
        <item name="backgroundTint">@color/white</item>
        <item name="rippleColor">@color/yakyeon_mint</item>
        <item name="minTouchTargetSize">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <style name="Widget.Yakyeon.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox" />

    <style name="Widget.Yakyeon.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/yakyeon_control_tint</item>
        <item name="buttonIconTint">@color/yakyeon_checkbox_icon</item>
        <item name="rippleColor">@color/yakyeon_mint</item>
    </style>

    <style name="Widget.Yakyeon.RoundCheck" parent="Widget.Yakyeon.CheckBox">
        <item name="minTouchTargetSize">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">1dp</item>
        <item name="android:paddingEnd">1dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Yakyeon.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/yakyeon_control_tint</item>
        <item name="rippleColor">@color/yakyeon_mint</item>
    </style>

    <style name="Widget.Yakyeon.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch" />

    <style name="TextAppearance.Yakyeon.Tab" parent="TextAppearance.AppCompat">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Yakyeon.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="Widget.Yakyeon.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="strokeColor">@color/yakyeon_card_line</item>
        <item name="rippleColor">@color/yakyeon_mint</item>
    </style>

    <style name="ThemeOverlay.Yakyeon.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorPrimary">@color/yakyeon_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/white</item>
        <item name="colorSecondaryContainer">@color/yakyeon_mint</item>
        <item name="colorOnSurface">@color/yakyeon_text</item>
        <item name="colorOnSurfaceVariant">@color/yakyeon_muted</item>
        <item name="android:textColorPrimary">@color/yakyeon_text</item>
    </style>

    <style name="ThemeOverlay.Yakyeon.CaregiverDialog" parent="ThemeOverlay.Yakyeon.Dialog" />

    <style name="ThemeOverlay.Yakyeon.ConsentCard" parent="ThemeOverlay.Yakyeon.Dialog">
        <item name="android:backgroundDimAmount">0</item>
    </style>

    <style name="ThemeOverlay.Yakyeon.Popup" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="ThemeOverlay.Yakyeon.AlarmCard" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Widget.Yakyeon.DevFixture" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/yakyeon_chip_off</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/yakyeon_text</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>

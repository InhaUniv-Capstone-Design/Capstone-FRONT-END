<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageButton
        android:id="@+id/header_back"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/space_m"
        android:background="@drawable/yakyeon_back_plate"
        android:contentDescription="@string/header_back"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_header_back"
        android:visibility="gone" />

    <TextView
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.Yakyeon.Header"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/header_action_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/space_m"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/med_history_action"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_yakyeon_comment"
        android:visibility="gone" />

    <TextView
        android:id="@+id/header_action"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/min_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:textColor="@color/yakyeon_brand"
        android:textStyle="bold"
        android:visibility="gone" />

</merge>

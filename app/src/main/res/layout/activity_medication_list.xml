<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/medication_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/screen_padding"
    tools:context=".ui.medication.MedicationListActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/medication_list_title"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <FrameLayout
                android:id="@+id/header_notifications"
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/home_notifications"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/bell_icon_size"
                    android:layout_height="@dimen/bell_icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bell" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/medication_list_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/header_gap"
            android:textColor="@color/muted"
            android:textSize="12sp"
            tools:text="복용 중인 약 3개" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingTop="@dimen/card_padding"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/medication_active_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medication_section_active"
                    android:textColor="@color/brand_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/header_gap"
                    android:background="@drawable/bg_surface_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/medication_active_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_medication" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/medication_ended_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medication_section_ended"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/header_gap"
                    android:background="@drawable/bg_surface_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/medication_ended_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="1"
                        tools:listitem="@layout/item_medication" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/medication_register_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/login_button_height"
                android:layout_marginTop="@dimen/section_gap"
                android:background="@drawable/bg_button_brand"
                android:clickable="true"
                android:contentDescription="@string/medication_register"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/medication_register_plus"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:text="@string/medication_register"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>

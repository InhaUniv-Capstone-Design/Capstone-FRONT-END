<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/yakyeon_popup_card"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/text_confirm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/yakyeon_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.45"
        android:textColor="@color/yakyeon_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/confirm_icon_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/image_confirm_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/button_confirm_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_modal_cancel"
            android:gravity="center"
            android:textColor="@color/yakyeon_muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/button_confirm_ok"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_modal_primary"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

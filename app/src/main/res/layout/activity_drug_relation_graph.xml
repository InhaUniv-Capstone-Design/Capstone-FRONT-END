<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/graph_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/header_gap"
    android:paddingEnd="@dimen/screen_padding"
    tools:context=".ui.graph.DrugRelationGraphActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/graph_title"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <FrameLayout
                android:layout_width="@dimen/back_button_size"
                android:layout_height="@dimen/back_button_size">

                <ImageView
                    android:layout_width="@dimen/bell_icon_size"
                    android:layout_height="@dimen/bell_icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="@string/home_notifications"
                    android:src="@drawable/ic_bell" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/header_gap"
            android:text="@string/graph_subtitle"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/header_gap"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_card"
                android:clipToOutline="true"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <WebView
                    android:id="@+id/graph_canvas"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:contentDescription="@string/graph_canvas" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:background="@drawable/bg_graph_list"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/graph_relation_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="함께 보는 관계 1" />

                <LinearLayout
                    android:id="@+id/graph_relation_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@string/auth_brand"
            android:scaleType="fitCenter"
            android:scaleY="-1"
            android:src="@drawable/yakyeon_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/auth_brand"
            android:textColor="@color/yakyeon_brand"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/auth_tagline"
            android:textColor="@color/yakyeon_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_id_label"
        android:textColor="@color/yakyeon_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.example.yakyeon2.ui.YakyeonTextField
        android:id="@+id/field_login_id"
        style="@style/Widget.Yakyeon.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/auth_password_label"
        android:textColor="@color/yakyeon_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.example.yakyeon2.ui.YakyeonTextField
        android:id="@+id/field_login_password"
        style="@style/Widget.Yakyeon.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_login"
        style="@style/Widget.Yakyeon.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="@string/auth_login"
        android:textStyle="normal" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_open_signup"
        style="@style/Widget.Yakyeon.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="@string/auth_signup"
        android:textStyle="normal" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_dev_home"
        style="@style/Widget.Yakyeon.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/auth_dev_home"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_dev_pillbox_scenario"
        style="@style/Widget.Yakyeon.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/auth_dev_pillbox_scenario"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_dev_home_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/auth_dev_home_note"
        android:textColor="@color/yakyeon_muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/auth_login_notice"
        android:textColor="@color/yakyeon_muted"
        android:textSize="10sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="@dimen/dialog_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dialog"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pillbox_consent_title"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.45"
            android:text="@string/pillbox_consent_message"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_consent_step"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_circle_brand"
                android:gravity="center"
                android:text="@string/pillbox_consent_step_number"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/pillbox_consent_step"
                android:textColor="@color/ink"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_placeholder_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/pillbox_consent_legal"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_placeholder_bar" />

            <View
                android:layout_width="180dp"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_placeholder_bar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillbox_consent_check_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_consent_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/pillbox_consent_check_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/not_selected"
                android:src="@drawable/ic_checkbox" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/pillbox_consent_item"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pillbox_consent_later"
                style="@style/Widget.Yakyeon.Button.Ghost"
                android:layout_width="104dp"
                android:layout_height="@dimen/action_button_height"
                android:text="@string/pillbox_consent_later" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pillbox_consent_agree"
                style="@style/Widget.Yakyeon.Button.Primary.Compact"
                android:layout_width="0dp"
                android:layout_height="@dimen/action_button_height"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/pillbox_consent_agree" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

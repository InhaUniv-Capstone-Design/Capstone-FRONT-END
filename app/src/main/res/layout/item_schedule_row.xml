<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="54dp"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/icon_round"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/yakyeon_icon_round"
        android:contentDescription="@string/med_field_count"
        android:padding="10dp"
        android:src="@drawable/ic_yakyeon_sun" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_schedule_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/yakyeon_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_schedule_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/yakyeon_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/text_schedule_revise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/med_revise"
            android:textColor="@color/yakyeon_delayed_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_schedule_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/yakyeon_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_schedule_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>

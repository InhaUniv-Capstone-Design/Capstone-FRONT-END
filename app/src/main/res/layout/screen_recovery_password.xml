<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_reset_section_help"
        android:textColor="@color/yakyeon_muted"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Yakyeon.FieldLabel"
                android:text="@string/auth_id_label" />

            <com.example.yakyeon2.ui.YakyeonTextField
                android:id="@+id/field_reset_id"
                style="@style/Widget.Yakyeon.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                style="@style/Widget.Yakyeon.FieldLabel"
                android:text="@string/auth_new_password_label" />

            <com.example.yakyeon2.ui.YakyeonTextField
                android:id="@+id/field_reset_password"
                style="@style/Widget.Yakyeon.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                style="@style/Widget.Yakyeon.FieldLabel"
                android:text="@string/auth_reset_confirm_label" />

            <com.example.yakyeon2.ui.YakyeonTextField
                android:id="@+id/field_reset_confirm"
                style="@style/Widget.Yakyeon.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/text_reset_password_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auth_password_rule_caption"
                android:textColor="@color/yakyeon_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_reset_password"
        style="@style/Widget.Yakyeon.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="@string/auth_reset_password"
        android:textStyle="normal" />
</LinearLayout>

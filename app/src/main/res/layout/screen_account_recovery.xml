<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_find_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/auth_find_id"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/label_find_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_find_id"
                android:textColor="@color/yakyeon_brand"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicator_find_id"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:background="@color/yakyeon_brand"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_find_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/auth_find_password"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/label_find_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_find_password"
                android:textColor="@color/yakyeon_muted"
                android:textSize="14sp" />

            <View
                android:id="@+id/indicator_find_password"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:background="@color/yakyeon_brand"
                android:importantForAccessibility="no"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yakyeon_line"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/panel_find_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_find_id_help"
                    android:textColor="@color/yakyeon_muted"
                    android:textSize="12sp" />

                <TextView
                    style="@style/Widget.Yakyeon.FieldLabel"
                    android:text="@string/auth_recovery_name_label" />

                <com.example.yakyeon2.ui.YakyeonTextField
                    android:id="@+id/field_find_name"
                    style="@style/Widget.Yakyeon.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    style="@style/Widget.Yakyeon.FieldLabel"
                    android:text="@string/auth_recovery_phone_label" />

                <com.example.yakyeon2.ui.YakyeonTextField
                    android:id="@+id/field_find_phone"
                    style="@style/Widget.Yakyeon.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_find_id"
                    style="@style/Widget.Yakyeon.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/auth_next"
                    android:textStyle="normal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panel_find_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_find_password_help"
                    android:textColor="@color/yakyeon_muted"
                    android:textSize="12sp" />

                <TextView
                    style="@style/Widget.Yakyeon.FieldLabel"
                    android:text="@string/auth_id_label" />

                <com.example.yakyeon2.ui.YakyeonTextField
                    android:id="@+id/field_reset_id"
                    style="@style/Widget.Yakyeon.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    style="@style/Widget.Yakyeon.FieldLabel"
                    android:text="@string/auth_recovery_phone_label" />

                <com.example.yakyeon2.ui.YakyeonTextField
                    android:id="@+id/field_reset_phone"
                    style="@style/Widget.Yakyeon.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reset_next"
                    style="@style/Widget.Yakyeon.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/auth_next"
                    android:textStyle="normal" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_medicine"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/yakyeon_icon_tile"
        android:contentDescription="@string/med_field_name"
        android:padding="10dp"
        android:src="@drawable/ic_yakyeon_pill" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_medicine_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/yakyeon_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_medicine_frequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/yakyeon_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="@dimen/dialog_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dialog"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pillbox_device_name_label"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pillbox_rename_input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/field_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pillbox_rename_cancel"
                style="@style/Widget.Yakyeon.Button.Ghost"
                android:layout_width="104dp"
                android:layout_height="@dimen/action_button_height"
                android:text="@string/close" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pillbox_rename_save"
                style="@style/Widget.Yakyeon.Button.Primary.Compact"
                android:layout_width="0dp"
                android:layout_height="@dimen/action_button_height"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/pillbox_change" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <TextView
            android:id="@+id/text_search_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/yakyeon_text"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_search_med"
            style="@style/Widget.Yakyeon.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/med_search" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_amount"
            style="@style/Widget.Yakyeon.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/med_amount_unset" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/check_morning"
                style="@style/Widget.Yakyeon.RoundCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/round_morning" />

            <CheckBox
                android:id="@+id/check_lunch"
                style="@style/Widget.Yakyeon.RoundCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/round_lunch" />

            <CheckBox
                android:id="@+id/check_evening"
                style="@style/Widget.Yakyeon.RoundCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/round_evening" />

            <CheckBox
                android:id="@+id/check_bedtime"
                style="@style/Widget.Yakyeon.RoundCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/round_bedtime" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_frequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/yakyeon_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_timing"
            style="@style/Widget.Yakyeon.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/med_timing_unset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_start"
            style="@style/Widget.Yakyeon.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/med_date_unset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_end"
            style="@style/Widget.Yakyeon.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/med_date_unset" />

        <CheckBox
            android:id="@+id/check_confirmed"
            style="@style/Widget.Yakyeon.CheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/med_confirm_item" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_med"
            style="@style/Widget.Yakyeon.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/med_delete" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_med"
            style="@style/Widget.Yakyeon.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/med_save_edit"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_without_pillbox"
            style="@style/Widget.Yakyeon.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/med_without_pillbox" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_into_pillbox"
            style="@style/Widget.Yakyeon.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/med_into_pillbox" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/screen_padding"
    tools:context=".ui.medication.MedicationScheduleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_title"
            android:textColor="@color/ink"
            android:textSize="20sp" />

        <FrameLayout
            android:layout_width="@dimen/back_button_size"
            android:layout_height="@dimen/back_button_size">

            <ImageView
                android:layout_width="@dimen/bell_icon_size"
                android:layout_height="@dimen/bell_icon_size"
                android:layout_gravity="center"
                android:contentDescription="@string/home_notifications"
                android:src="@drawable/ic_bell" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/schedule_header_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/header_gap"
        android:textColor="@color/muted"
        android:textSize="12sp"
        tools:text="2026년 10월 6일 화요일" />

    <LinearLayout
        android:id="@+id/schedule_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/schedule_selected_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="2026년 10월 6일 화요일" />

        <TextView
            android:id="@+id/schedule_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/brand_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="오늘 4회 예정" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/schedule_doses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp" />
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>

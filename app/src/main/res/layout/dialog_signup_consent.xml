<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_consent_title"
        android:textColor="@color/yakyeon_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/auth_consent_subtitle"
        android:textColor="@color/yakyeon_muted"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/consent_scroll_terms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/yakyeon_consent_scroll_frame"
        android:fillViewport="false"
        android:nestedScrollingEnabled="true"
        android:padding="8dp"
        android:scrollbarThumbVertical="@drawable/yakyeon_consent_scrollbar"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/text_terms_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/yakyeon_text"
            android:textSize="13sp" />
    </ScrollView>

    <CheckBox
        android:id="@+id/check_terms"
        style="@style/Widget.Yakyeon.CheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="36dp"
        android:text="@string/auth_consent_terms"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/consent_scroll_other"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/yakyeon_consent_scroll_frame"
        android:fillViewport="false"
        android:nestedScrollingEnabled="true"
        android:padding="8dp"
        android:scrollbarThumbVertical="@drawable/yakyeon_consent_scrollbar"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/text_privacy_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/yakyeon_text"
            android:textSize="13sp" />
    </ScrollView>

    <CheckBox
        android:id="@+id/check_privacy"
        style="@style/Widget.Yakyeon.CheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="36dp"
        android:text="@string/auth_consent_privacy"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/check_notice"
        style="@style/Widget.Yakyeon.CheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/auth_consent_notice"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/check_sensitive"
        style="@style/Widget.Yakyeon.CheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/auth_consent_sensitive"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/auth_consent_not_stored"
        android:textColor="@color/yakyeon_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_consent_cancel"
            style="@style/Widget.Yakyeon.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_consent_proceed"
            style="@style/Widget.Yakyeon.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:text="@string/auth_consent_proceed"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>

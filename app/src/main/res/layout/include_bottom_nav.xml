<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_nav_height"
    android:background="@drawable/bg_bottom_nav"
    android:orientation="horizontal"
    android:paddingTop="8dp">

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/nav_home"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:minHeight="52dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_home_icon"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_home" />

        <TextView
            android:id="@+id/nav_home_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/nav_home"
            android:textColor="@color/nav_active"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_graph"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/nav_graph"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:minHeight="52dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_graph_icon"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_chart" />

        <TextView
            android:id="@+id/nav_graph_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/nav_graph"
            android:textColor="@color/nav_inactive"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_pillbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/nav_pillbox"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:minHeight="52dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_pillbox_icon"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_pillbox" />

        <TextView
            android:id="@+id/nav_pillbox_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/nav_pillbox"
            android:textColor="@color/nav_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/nav_settings"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:minHeight="52dp"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/nav_settings"
            android:textColor="@color/nav_inactive"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_caregiver_title"
        android:textColor="@color/yakyeon_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/auth_caregiver_body"
        android:textColor="@color/yakyeon_muted"
        android:textSize="13sp" />

    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/care_qr_title"
        android:scaleType="fitCenter"
        android:src="@drawable/care_qr_code" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/yakyeon_sheet"
        android:padding="12dp"
        android:text="@string/auth_caregiver_note"
        android:textColor="@color/yakyeon_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_caregiver_close"
            style="@style/Widget.Yakyeon.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/auth_close"
            android:textColor="@color/yakyeon_text"
            app:backgroundTint="@color/white"
            app:rippleColor="@color/yakyeon_mint"
            app:strokeColor="@color/yakyeon_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_caregiver_continue"
            style="@style/Widget.Yakyeon.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.6"
            android:text="@string/auth_caregiver_continue"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="@color/yakyeon_primary"
            app:rippleColor="@color/yakyeon_mint" />
    </LinearLayout>
</LinearLayout>

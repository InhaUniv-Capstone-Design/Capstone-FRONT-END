<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_form_guide"
        android:textColor="@color/yakyeon_muted"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_form_title"
                android:textColor="@color/yakyeon_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/auth_form_help"
                android:textColor="@color/yakyeon_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_required_mark"
                    android:textColor="@color/yakyeon_required"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_required_legend"
                    android:textColor="@color/yakyeon_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Yakyeon.FieldLabel"
                android:text="@string/auth_name_label" />

            <com.example.yakyeon2.ui.YakyeonTextField
                android:id="@+id/field_name"
                style="@style/Widget.Yakyeon.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                style="@style/Widget.Yakyeon.FieldLabel"
                android:text="@string/auth_birth_label" />

            <com.example.yakyeon2.ui.YakyeonTextField
                android:id="@+id/field_birth"
                style="@style/Widget.Yakyeon.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                style="@style/Widget.Yakyeon.FieldLabel"
                android:text="@string/auth_phone_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.yakyeon2.ui.YakyeonTextField
                    android:id="@+id/field_phone"
                    style="@style/Widget.Yakyeon.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/text_code_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:minWidth="40dp"
                    android:textColor="@color/yakyeon_deep"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_request_code"
                    style="@style/Widget.Yakyeon.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/auth_request_code" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panel_verification_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Yakyeon.FieldLabel"
                    android:text="@string/auth_code_label" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp">

                    <com.example.yakyeon2.ui.YakyeonTextField
                        android:id="@+id/field_verification_code"
                        style="@style/Widget.Yakyeon.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/text_code_verified"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_code_verified"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/auth_phone_verified"
                        android:textColor="@color/yakyeon_deep"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panel_outbound_sms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_sms_code"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_sms_guide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/yakyeon_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_sms_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:letterSpacing="0.2"
                    android:textColor="@color/yakyeon_deep"
                    android:textIsSelectable="true"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_sms_digits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/auth_sms_digits_only"
                    android:textColor="@color/yakyeon_muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_open_sms"
                    style="@style/Widget.Yakyeon.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/auth_sms_open" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Yakyeon.FieldLabel"
                android:text="@string/auth_signup_id_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.yakyeon2.ui.YakyeonTextField
                    android:id="@+id/field_signup_id"
                    style="@style/Widget.Yakyeon.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_check_id"
                    style="@style/Widget.Yakyeon.Button.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/auth_check_duplicate" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Yakyeon.FieldLabel"
                android:text="@string/auth_signup_password_label" />

            <com.example.yakyeon2.ui.YakyeonTextField
                android:id="@+id/field_signup_password"
                style="@style/Widget.Yakyeon.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/auth_password_rule_caption"
                android:textColor="@color/yakyeon_muted"
                android:textSize="11sp" />

            <TextView
                style="@style/Widget.Yakyeon.FieldLabel"
                android:text="@string/auth_password_confirm_label" />

            <com.example.yakyeon2.ui.YakyeonTextField
                android:id="@+id/field_password_confirm"
                style="@style/Widget.Yakyeon.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_submit_signup"
        style="@style/Widget.Yakyeon.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/auth_signup" />
</LinearLayout>

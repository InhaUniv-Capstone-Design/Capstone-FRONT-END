<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ocr_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_ocr_item"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ocr_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="메트포르민정 500mg" />

        <TextView
            android:id="@+id/ocr_item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_review_badge"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="@string/ocr_review_badge"
            android:textColor="@color/review"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/medication_edit_name"
        android:textColor="@color/brand_dark"
        android:textSize="11sp" />

    <AutoCompleteTextView
        android:id="@+id/ocr_name"
        android:layout_width="match_parent"
        android:layout_height="@dimen/edit_field_height"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_edit_field"
        android:completionThreshold="1"
        android:gravity="center_vertical"
        android:hint="@string/medication_edit_name_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:popupBackground="@color/white"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/medication_edit_dose_amount"
        android:textColor="@color/brand_dark"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <AutoCompleteTextView
            android:id="@+id/ocr_dose_amount"
            android:layout_width="0dp"
            android:layout_height="@dimen/edit_field_height"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_field"
            android:clickable="true"
            android:cursorVisible="false"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:inputType="none"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:popupBackground="@color/white"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <AutoCompleteTextView
            android:id="@+id/ocr_dose_unit"
            android:layout_width="0dp"
            android:layout_height="@dimen/edit_field_height"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_field"
            android:clickable="true"
            android:cursorVisible="false"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:inputType="none"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:popupBackground="@color/white"
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/medication_edit_times_per_day"
        android:textColor="@color/brand_dark"
        android:textSize="11sp" />

    <AutoCompleteTextView
        android:id="@+id/ocr_times_per_day"
        android:layout_width="match_parent"
        android:layout_height="@dimen/edit_field_height"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_edit_field"
        android:clickable="true"
        android:cursorVisible="false"
        android:drawableEnd="@drawable/ic_chevron_down"
        android:drawablePadding="4dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:inputType="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:popupBackground="@color/white"
        android:textColor="@color/ink"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/medication_edit_dose_times"
        android:textColor="@color/brand_dark"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/ocr_dose_times"
        android:layout_width="match_parent"
        android:layout_height="@dimen/edit_field_height"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_edit_field"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:hint="@string/medication_edit_time_hint"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/medication_edit_dose_timing"
        android:textColor="@color/brand_dark"
        android:textSize="11sp" />

    <AutoCompleteTextView
        android:id="@+id/ocr_dose_timing"
        android:layout_width="match_parent"
        android:layout_height="@dimen/edit_field_height"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_edit_field"
        android:clickable="true"
        android:cursorVisible="false"
        android:drawableEnd="@drawable/ic_chevron_down"
        android:drawablePadding="4dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:inputType="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:popupBackground="@color/white"
        android:textColor="@color/ink"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/medication_edit_duration"
        android:textColor="@color/brand_dark"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ocr_start_date"
            android:layout_width="0dp"
            android:layout_height="@dimen/edit_field_height"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_field"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/ocr_period_separator"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ocr_end_date"
            android:layout_width="0dp"
            android:layout_height="@dimen/edit_field_height"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_field"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

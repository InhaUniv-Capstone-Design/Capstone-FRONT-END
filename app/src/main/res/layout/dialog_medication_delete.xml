<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="@dimen/dialog_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/medication_delete_title"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.45"
        android:text="@string/medication_delete_message"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="@dimen/confirm_icon_size"
        android:layout_height="@dimen/confirm_icon_size"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_confirm_icon_danger">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_trash" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/delete_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/action_button_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/medication_cancel"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/delete_confirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/action_button_height"
            android:layout_weight="1"
            android:background="@drawable/bg_button_danger"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/medication_delete_confirm"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>

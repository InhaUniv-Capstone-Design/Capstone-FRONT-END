<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auth_find_result_title"
        android:textColor="@color/yakyeon_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_found_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_account_not_found"
                android:textColor="@color/yakyeon_text"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/list_found_accounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_recovery_login"
        style="@style/Widget.Yakyeon.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="@string/auth_go_login"
        android:textStyle="normal" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_recovery_to_reset"
        style="@style/Widget.Yakyeon.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="@string/auth_reset_password"
        android:textStyle="normal" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yakyeon">
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.SignupTypeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.SignupFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.medication.MedicationListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.medication.MedicationScheduleActivity"
            android:exported="false" />
        <activity
            android:name=".ui.medication.MedicationReminderActivity"
            android:exported="false" />
        <activity
            android:name=".ui.medication.PrescriptionOcrActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dur.DurInteractionListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dur.DurInteractionDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.graph.DrugRelationGraphActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pillbox.PillboxActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.pillbox.DeviceSearchActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pillbox.PillboxSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pillbox.PillboxAlarmActivity"
            android:exported="false" />
    </application>

</manifest>